# --- Virtual environments ---
.venv/
venv/
env/

# --- Trained model weights & checkpoints (~80 GB, fully regenerable) ---
models/
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
checkpoints/
checkpoint-*/

# --- Large/redundant backups ---
backup/

# --- Scratch & skill clone (never commit) ---
# `work/` berisi backup DOCX + ekstraksi XML sementara; `office-skripsi/`
# adalah repo Git terpisah (kalau di-`git add`, jadi gitlink tanpa .gitmodules).
Laporan_skripsi/work/
Laporan_skripsi/office-skripsi/

# --- Byte-compiled / cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# --- Logs & temp ---
*.log
*.zip
nohup.out

# --- Word temp/lock (dibuat saat Word membuka dokumen) ---
~$*.docx
~$*.doc
~WRL*.tmp

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Local secrets & env ---
.env
.env.local
*_token*
*_secret*
cookie*.json
*.session

# --- Scraped data cache ---
data/cache/